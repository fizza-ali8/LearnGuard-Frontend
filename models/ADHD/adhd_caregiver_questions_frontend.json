      "number": 1,
      "feature_key": "sc_age_years",
      "section": "Child information",
      "question": "How old is your child (in completed years)?",
      "input_type": "single_select",
      "required": true,
      "options": [
        {
          "label": "6 years",
          "value": 6
        },
        {
          "label": "7 years",
          "value": 7
        },
        {
          "label": "8 years",
          "value": 8
        },
        {
          "label": "9 years",
          "value": 9
        },
        {
          "label": "10 years",
          "value": 10
        },
        {
          "label": "11 years",
          "value": 11
        }
      ]
    },
