{
  "module": "adhd",
  "title": "LearnGuard ADHD — Caregiver Questionnaire",
  "audience": "Parent or adult caregiver familiar with the child",
  "age_range_years": [
    6,
    11
  ],
  "source": "NSCH 2022 T2 questionnaire; mappings verified against the saved LearnGuard ADHD model schema",
  "instructions": "Select exactly one answer for every question. Answer based on the child’s usual behavior or the period stated. Do not guess when an answer is unknown; the current API requires all answers and does not accept an Unknown option.",
  "screening_disclaimer": "This questionnaire supports an ADHD-related research screening model. It is not an ADHD diagnosis or a replacement for professional assessment.",
  "api": {
    "method": "POST",
    "path": "/api/adhd/predict",
    "payload_key": "answers",
    "payload_values": "Integer codes from the selected options",
    "question_endpoint": "GET /api/adhd/questions"
  },
  "questions": [
